# Same-origin API for Next.js Route Handlers. Override only when the API lives on another origin.
NEXT_PUBLIC_API_BASE_URL=/api

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
GOOGLE_SITE_VERIFICATION=

# Persistent JSON storage (required for production)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data
DATA_STORAGE_MODE=github
